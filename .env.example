# StreamPulse Production Environment Configuration Placeholders
# IMPORTANT: DO NOT PUT REAL SECRETS IN THIS FILE.

# Option 1: Base64-encoded Netscape-format cookies file for Render secret environment variables
# Generate with: base64 -w 0 cookies.txt (Linux/macOS) or [Convert]::ToBase64String([IO.File]::ReadAllBytes("cookies.txt")) (PowerShell)
YOUTUBE_COOKIES_BASE64=

# Option 2: Path to a mounted/server-side cookies file
YOUTUBE_COOKIES_PATH=

# Maximum download timeout in milliseconds (Default: 300000 ms = 5 minutes)
DOWNLOAD_TIMEOUT_MS=300000

# Maximum number of concurrent downloads (Default: 3)
MAX_CONCURRENT_DOWNLOADS=3

# Server listening port (Render sets this automatically)
PORT=8000
